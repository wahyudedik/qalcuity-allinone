{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./apps/web/*"
            ],
            "@qalcuity/ui": [
                "./packages/ui/src"
            ],
            "@qalcuity/db": [
                "./packages/db/src"
            ],
            "@qalcuity/utils": [
                "./packages/utils/src"
            ],
            "@qalcuity/analytics": [
                "./packages/analytics/src"
            ],
            "@qalcuity/config": [
                "./packages/config/src"
            ],
            "@qalcuity/types": [
                "./packages/types/src"
            ],
            "@qalcuity/i18n": [
                "./packages/i18n/src"
            ],
            "@qalcuity/validation": [
                "./packages/validation/src"
            ],
            "@qalcuity/permissions": [
                "./packages/permissions/src"
            ],
            "@qalcuity/workflow": [
                "./packages/workflow/src"
            ],
            "@qalcuity/industry-config": [
                "./packages/industry-config/src"
            ],
            "@qalcuity/api": [
                "./packages/api/src"
            ],
            "@qalcuity/redis": [
                "./packages/db/src"
            ]
        },
        "plugins": [
            {
                "name": "typescript-plugin-css-modules"
            }
        ]
    },
    "exclude": [
        "node_modules",
        "dist",
        "build",
        ".next",
        ".turbo",
        "apps/mobile"
    ]
}