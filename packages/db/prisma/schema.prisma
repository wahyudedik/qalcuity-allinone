// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & AUTH
// ============================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  contacts  Contact[]
  products  Product[]
  invoices  Invoice[]
  payments  Payment[]
  purchaseOrders PurchaseOrder[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatar        String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  roles         UserRole[]
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenantId    String
  users       UserRole[]

  @@unique([name, tenantId])
  @@map("roles")
}

model UserRole {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  user     User   @relation(fields: [userId], references: [id])
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// CONTACTS (Customers & Suppliers)
// ============================================

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Contact {
  id        String      @id @default(cuid())
  name      String
  type      ContactType @default(CUSTOMER)
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  postalCode String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])

  invoices  Invoice[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([type])
  @@map("contacts")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(15, 2)
  cost        Decimal  @default(0) @db.Decimal(15, 2)
  stock       Int      @default(0)
  unit        String   @default("pcs")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  invoiceItems       InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@map("products")
}

// ============================================
// INVOICES
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(cuid())
  number      String
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime
  notes       String?
  total       Decimal       @default(0) @db.Decimal(15, 2)
  paid        Decimal       @default(0) @db.Decimal(15, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id])

  items       InvoiceItem[]
  payments    Payment[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)

  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

// ============================================
// PAYMENTS
// ============================================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CREDIT_CARD
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())

  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@map("payments")
}

// ============================================
// PURCHASE ORDERS
// ============================================

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  number      String
  status      POStatus @default(DRAFT)
  total       Decimal  @default(0) @db.Decimal(15, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])

  items       PurchaseOrderItem[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
