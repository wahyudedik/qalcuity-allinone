// Prisma Schema for Qalcuity
// PostgreSQL — production-ready with native Decimal types for monetary fields.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & AUTH
// ============================================

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Subscription fields
  subscriptionStatus String    @default("TRIAL") // TRIAL, ACTIVE, PENDING_PAYMENT, SUSPENDED, CANCELLED
  trialEndsAt        DateTime?
  currentPlanSlug    String?   // starter, growth, business

  users          User[]
  roles          Role[]
  contacts       Contact[]
  products       Product[]
  categories     Category[]
  suppliers      Supplier[]
  stockMovements StockMovement[]
  warehouses     Warehouse[]
  stockOpnames   StockOpname[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  quotations     Quotation[]
  leads          Lead[]
  deals          Deal[]
  employees      Employee[]
  attendanceRecords AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]
  auditLogs      AuditLog[]
  subscriptions  TenantSubscription[]
  billingPayments BillingPayment[]
  coaAccounts     CoAAccount[]
  bankTransactions BankTransaction[]
  journalEntries  JournalEntry[]
  journalEntryItems JournalEntryItem[]
  savedReports      SavedReport[]
  scheduledReports  ScheduledReport[]
  kpis              KPI[]
  alertRules        AlertRule[]
  userDashboards    UserDashboard[]

  // Tax Engine
  taxRates          TaxRate[]

  // Period Closing
  accountingPeriods AccountingPeriod[]

  // Entitlement Engine
  entitlement   TenantEntitlement?
  usageRecords  UsageRecord[]

  // Rate Limiting
  rateLimitLogs     RateLimitLog[]

  // Settings
  notificationSettings  TenantNotificationSettings?
  integrations          TenantIntegration[]

  // Analytics Studio
  analyticsDatasets     AnalyticsDataset[]
  analyticsQueryHistory AnalyticsQueryHistory[]
  analyticsCharts       AnalyticsChart[]
  analyticsDashboards   AnalyticsDashboard[]
  analyticsWidgets      AnalyticsDashboardWidget[]
  dataDictionaryEntries DataDictionaryEntry[]
  scheduledQueries      ScheduledQuery[]
  metricDefinitions     MetricDefinition[]

  // CRM Activities
  activities        Activity[]

  // Workflow Engine
  workflowDefinitions   WorkflowDefinition[]
  workflowHistory       WorkflowHistory[]

  // Industry Configuration Engine
  industryConfig    IndustryConfiguration?
  customFields      TenantCustomField[]

  // Approval Engine
  approvalLevels    ApprovalLevel[]
  approvalRequests  ApprovalRequest[]

  // Security: Sessions & Login History
  userSessions      UserSession[]
  loginLogs         LoginLog[]

  // In-App Notifications
  inAppNotifications InAppNotification[]

  // POS (Point of Sale)
  posTerminals       PosTerminal[]
  posSessions        PosSession[]
  posTransactions    PosTransaction[]
  posTransactionItems PosTransactionItem[]
  posPayments        PosPayment[]
  posRefunds         PosRefund[]
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  avatar        String?
  phone         String?
  role          String     @default("USER")
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  // Custom role reference (optional — system roles use the `role` string field)
  roleId        String?
  customRole    Role?     @relation(fields: [roleId], references: [id])

  // Two-Factor Authentication (2FA)
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  twoFactorBackupCodes String?  // JSON array of hashed backup codes

  auditLogs     AuditLog[]
  savedReports  SavedReport[]
  userDashboards UserDashboard[]

  // Sessions & Login History
  sessions      UserSession[]
  loginLogs     LoginLog[]

  // Analytics Studio
  analyticsQueryHistory AnalyticsQueryHistory[]
  analyticsCharts       AnalyticsChart[]
  analyticsDashboards   AnalyticsDashboard[]
  analyticsDatasets     AnalyticsDataset[]
  scheduledQueries      ScheduledQuery[]

  // Workflow Engine
  workflowHistory       WorkflowHistory[]

  @@index([tenantId])
  @@index([roleId])
}

// ============================================
// SECURITY: SESSIONS & LOGIN HISTORY
// ============================================

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  token       String   @unique
  device      String?
  ipAddress   String?
  userAgent   String?
  isActive    Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([isActive])
}

model LoginLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  email       String   // Email yang dicoba login (bisa dari user yang tidak ada)
  success     Boolean  @default(false)
  ipAddress   String?
  userAgent   String?
  failureReason String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
}

// ============================================
// PERMISSION & ROLE MANAGEMENT
// ============================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isSystem    Boolean  @default(false)  // System roles (SUPERADMIN, ADMIN, MEMBER, VIEWER) cannot be deleted
  permissions Json     @default("[]")   // Array of permission strings, e.g. ["finance:view", "crm:*"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ============================================
// CONTACTS (Customers & Suppliers)
// ============================================

model Contact {
  id         String    @id @default(cuid())
  name       String
  type       String    @default("CUSTOMER") // CUSTOMER, SUPPLIER, BOTH
  company    String?
  email      String?
  phone      String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  taxId      String?   // NPWP
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  invoices    Invoice[]
  leads       Lead[]
  deals       Deal[]
  quotations  Quotation[]

  @@index([tenantId])
  @@index([type])
}

// ============================================
// FINANCE
// ============================================

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String
  status          String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  dueDate         DateTime
  notes           String?
  subtotal        Decimal  @default(0) @db.Decimal(19, 4)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(19, 4)
  taxCode         String?  // "PPN", "PPH23" — snapshot code
  totalBeforeTax  Decimal  @default(0) @db.Decimal(19, 4)
  total           Decimal  @default(0) @db.Decimal(19, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id])

  items           InvoiceItem[]
  payments        Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([contactId])
  @@index([createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  total       Decimal @default(0) @db.Decimal(19, 4)

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================
// TAX ENGINE
// ============================================

model TaxRate {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String   // "PPN 11%", "PPh 23 2%"
  code          String   // "PPN", "PPH23", "PPH21"
  rate          Decimal  @db.Decimal(5, 2) // 11.00, 2.00
  type          String   @default("VAT") // VAT, INCOME_TAX, OTHER
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false) // Default tax untuk type ini
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, code])
}

model Payment {
  id            String   @id @default(cuid())
  paymentNumber String
  amount        Decimal  @default(0) @db.Decimal(19, 4)
  paymentDate   DateTime
  method        String   @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CREDIT_CARD, E_WALLET
  status        String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  notes         String?
  reference     String?
  type          String   @default("INCOME") // INCOME, EXPENSE
  createdAt     DateTime @default(now())

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@index([type])
  @@index([paymentDate])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String
  status          String   @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  orderDate       DateTime
  deliveryDate    DateTime?
  notes           String?
  subtotal        Decimal  @default(0) @db.Decimal(19, 4)
  taxRate         Decimal  @default(11) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(19, 4)
  total           Decimal  @default(0) @db.Decimal(19, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])

  items           PurchaseOrderItem[]

  @@index([tenantId])
  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  description String
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal       @default(0) @db.Decimal(19, 4)
  total       Decimal       @default(0) @db.Decimal(19, 4)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String
  status          String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  validUntil      DateTime
  notes           String?
  terms           String?
  subtotal        Decimal  @default(0) @db.Decimal(19, 4)
  taxRate         Decimal  @default(11) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(19, 4)
  discount        Decimal  @default(0) @db.Decimal(19, 4)
  total           Decimal  @default(0) @db.Decimal(19, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id])

  items           QuotationItem[]

  @@index([tenantId])
  @@index([status])
  @@index([contactId])
}

model QuotationItem {
  id          String     @id @default(cuid())
  description String
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal    @default(0) @db.Decimal(19, 4)
  total       Decimal    @default(0) @db.Decimal(19, 4)

  quotationId String
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// ============================================
// CRM
// ============================================

model Lead {
  id          String   @id @default(cuid())
  name        String
  company     String?
  email       String?
  phone       String?
  source      String?  // WEBSITE, REFERRAL, COLD_CALL, SOCIAL_MEDIA, OTHER
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  value       Decimal  @default(0) @db.Decimal(19, 4)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])

  deals       Deal[]

  @@index([tenantId])
  @@index([status])
  @@index([contactId])
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  value       Decimal  @default(0) @db.Decimal(19, 4)
  stage       String   @default("DISCOVERY") // DISCOVERY, PROPOSAL, NEGOTIATION, CLOSING, CLOSED_WON, CLOSED_LOST
  probability Int      @default(0)
  closeDate   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([stage])
  @@index([contactId])
}

// ============================================
// INVENTORY
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  products    Product[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  city            String?
  rating          Decimal  @default(0) @db.Decimal(3, 1)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  purchaseOrders  PurchaseOrder[]

  @@index([tenantId])
}

model Product {
  id          String    @id @default(cuid())
  sku         String
  name        String
  description String?
  unit        String    @default("pcs")
  price       Decimal   @default(0) @db.Decimal(19, 4)
  cost        Decimal   @default(0) @db.Decimal(19, 4)
  stock       Int       @default(0)
  minStock    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  stockMovements    StockMovement[]
  stockOpnameItems  StockOpnameItem[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@index([categoryId])
}

model StockMovement {
  id          String   @id @default(cuid())
  type        String   // IN, OUT, ADJUSTMENT
  quantity    Int
  reference   String?  // PO number, Invoice number, etc.
  notes       String?
  createdAt   DateTime @default(now())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([type])
}

// ============================================
// WAREHOUSE & STOCK OPNAME
// ============================================

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String
  address     String?
  city        String?
  phone       String?
  email       String?
  manager     String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  products      Product[]
  stockOpnames  StockOpname[]

  @@unique([code, tenantId])
  @@index([tenantId])
}

model StockOpname {
  id              String   @id @default(cuid())
  opnameNumber    String
  status          String   @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  opnameDate      DateTime @default(now())
  notes           String?
  totalDifference  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])

  items           StockOpnameItem[]

  @@unique([opnameNumber, tenantId])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
}

model StockOpnameItem {
  id              String   @id @default(cuid())
  systemQuantity  Int
  physicalQuantity Int
  difference      Int
  notes           String?
  createdAt       DateTime @default(now())

  stockOpnameId   String
  stockOpname     StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  @@index([stockOpnameId])
  @@index([productId])
}

// ============================================
// HR
// ============================================

model Employee {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  email       String
  phone       String?
  position    String
  department  String?
  joinDate    DateTime
  salary      Decimal   @default(0) @db.Decimal(19, 4)
  status      String    @default("ACTIVE") // ACTIVE, INACTIVE, TERMINATED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  attendanceRecords AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]

  @@unique([employeeId, tenantId])
  @@index([tenantId])
  @@index([status])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      String   @default("PRESENT") // PRESENT, LATE, ABSENT, LEAVE, WFH
  workHours   Decimal  @default(0) @db.Decimal(5, 2)
  notes       String?
  createdAt   DateTime @default(now())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date, tenantId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  type        String   @default("ANNUAL") // ANNUAL, SICK, PERSONAL, MATERNITY, UNPAID
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedDate DateTime @default(now())
  approvedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
}

model PayrollRecord {
  id            String   @id @default(cuid())
  period        String   // e.g. "2026-08"
  baseSalary    Decimal  @db.Decimal(19, 4)
  allowances    Decimal  @default(0) @db.Decimal(19, 4)
  deductions    Decimal  @default(0) @db.Decimal(19, 4)
  bonus         Decimal  @default(0) @db.Decimal(19, 4)
  netSalary     Decimal  @db.Decimal(19, 4)
  status        String   @default("PENDING") // PENDING, PROCESSED, PAID
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, period, tenantId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([period])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([entity])
}

// ============================================================
// BILLING & SUBSCRIPTION MODELS
// ============================================================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   // Starter, Growth, Business
  slug          String   @unique // starter, growth, business
  description   String?
  price         Decimal  @default(0) @db.Decimal(19, 4) // Harga dalam Rupiah
  billingPeriod String   @default("monthly") // monthly, yearly
  maxUsers      Int      @default(5)
  maxProducts   Int      @default(100)
  maxStorage    String?  // "5GB", "10GB", "50GB"
  features      String?  // JSON string array of features
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  status          String   @default("TRIAL") // TRIAL, ACTIVE, PENDING_PAYMENT, SUSPENDED, CANCELLED
  startDate       DateTime @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  paymentMethod   String?  // manual_transfer
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        BillingPayment[]

  @@index([tenantId])
  @@index([status])
}

model BillingPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount          Decimal  @default(0) @db.Decimal(19, 4) // Amount in Rupiah
  paymentMethod   String   // manual_transfer
  bankName        String?  // BRI, JAGO, BTN, BSI
  accountNumber   String?  // Rekening pengirim
  accountName     String?  // Nama pengirim
  proofFileUrl    String?  // URL/path bukti transfer
  proofFileName   String?  // Original filename
  reference       String?  // Reference number from user
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedById    String?  // userId of admin who verified
  verifiedAt      DateTime?
  rejectReason    String?
  notes           String?
  waConfirmed     Boolean  @default(false) // User sudah konfirmasi via WA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([subscriptionId])
}

// ============================================================
// CHART OF ACCOUNTS (CoA) & RECONCILIATION
// ============================================================

model CoAAccount {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  type        String   // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description String   @default("")
  parentId    String?
  balance     Decimal  @default(0) @db.Decimal(19, 4)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  parent          CoAAccount?  @relation("CoATree", fields: [parentId], references: [id])
  children        CoAAccount[] @relation("CoATree")
  matchedTransactions BankTransaction[]
  journalEntryItems  JournalEntryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
}

model BankTransaction {
  id                String    @id @default(cuid())
  tenantId          String
  date              DateTime
  description       String
  amount            Decimal   @default(0) @db.Decimal(19, 4)
  type              String    // credit, debit
  status            String    @default("unmatched") // unmatched, matched, discrepancy
  matchedAccountId  String?
  bankReference     String?
  discrepancyNote   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  matchedAccount  CoAAccount? @relation(fields: [matchedAccountId], references: [id])

  @@index([tenantId, status])
  @@index([matchedAccountId])
}

// ============================================
// ANALYTICS & DECISION INTELLIGENCE
// ============================================

model SavedReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("report") // report | chart | pivot | query | dashboard
  config      Json     // AnalyticsQueryConfig, ChartConfig, atau PivotConfig
  ownerId     String
  tenantId    String
  isStarred   Boolean  @default(false)
  tags        String[] @default([])
  folder      String?
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner      User                  @relation(fields: [ownerId], references: [id])
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  schedules  ScheduledReport[]
  executions SavedReportExecution[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([tenantId, type])
  @@index([tenantId, isStarred])
}

model SavedReportExecution {
  id           String   @id @default(cuid())
  reportId     String
  tenantId     String
  executedBy   String
  status       String   @default("completed") // running | completed | failed
  result       Json?    // execution result metadata
  rowcount     Int      @default(0)
  durationMs   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  report SavedReport @relation(fields: [reportId], references: [id])

  @@index([tenantId])
  @@index([reportId])
}

model ScheduledReport {
  id              String   @id @default(cuid())
  name            String
  reportId        String
  tenantId        String
  frequency       String   // daily | weekly | monthly | quarterly | yearly
  dayOfWeek       Int?     // 0-6 for weekly
  dayOfMonth      Int?     // 1-31 for monthly
  time            String   @default("08:00") // HH:mm
  outputFormats   String[] @default(["email"]) // pdf | excel | csv | email
  recipients      String[] @default([]) // user IDs or emails
  isActive        Boolean  @default(true)
  lastExecutedAt  DateTime?
  nextExecutionAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  report     SavedReport               @relation(fields: [reportId], references: [id])
  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  executions ScheduledReportExecution[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([nextExecutionAt])
}

model ScheduledReportExecution {
  id             String   @id @default(cuid())
  scheduleId     String
  tenantId       String
  status         String   @default("completed") // running | completed | failed | sent
  outputFormat   String?
  outputUrl      String?  // URL ke file output
  errorMessage   String?
  executedAt     DateTime @default(now())
  completedAt    DateTime?

  schedule ScheduledReport @relation(fields: [scheduleId], references: [id])

  @@index([tenantId])
  @@index([scheduleId])
}

model KPI {
  id                String   @id @default(cuid())
  name              String
  description       String?
  category          String   // finance | sales | inventory | hr | crm | cross_module
  metricId          String   // reference to metric definition
  formula           String?  // custom formula if not using built-in metric
  target            Decimal  @default(0)
  targetType        String   @default("gte") // gte (>=), lte (<=), eq (==)
  warningThreshold  Decimal? @default(10) // % below target
  criticalThreshold Decimal? @default(25) // % below target
  period            String   @default("monthly") // daily | weekly | monthly | quarterly | yearly
  ownerId           String?
  departmentId      String?
  tenantId          String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  evaluations KPIEvaluation[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

model KPIEvaluation {
  id            String   @id @default(cuid())
  kpiId         String
  tenantId      String
  value         Decimal
  target        Decimal
  status        String   // above_target | on_target | below_target | critical
  changePercent Decimal?
  previousValue Decimal?
  period        String   // e.g. "2026-08" or "2026-Q3"
  evaluatedAt   DateTime @default(now())

  kpi KPI @relation(fields: [kpiId], references: [id])

  @@index([tenantId])
  @@index([kpiId])
  @@index([kpiId, period])
}

model AlertRule {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  metricId             String
  condition            String   // below | above | equals | not_equals | changes_by
  threshold            Decimal
  severity             String   @default("medium") // low | medium | high | critical
  notificationChannels String[] @default(["in_app"]) // in_app | email | slack
  recipients           String[] @default([])
  cooldownMinutes      Int      @default(60)
  isActive             Boolean  @default(true)
  lastTriggeredAt      DateTime?
  tenantId             String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  triggers  AlertTrigger[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model AlertTrigger {
  id             String   @id @default(cuid())
  ruleId         String
  tenantId       String
  currentValue   Decimal
  threshold      Decimal
  severity       String
  message        String
  acknowledged   Boolean  @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  triggeredAt    DateTime @default(now())

  rule AlertRule @relation(fields: [ruleId], references: [id])

  @@index([tenantId])
  @@index([ruleId])
  @@index([tenantId, acknowledged])
}

model UserDashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  visibility  String   @default("private") // private | team | department | organization
  layout      Json     // DashboardLayout config
  widgets     Json     // DashboardWidgetConfig[]
  ownerId     String
  tenantId    String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id])
  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([tenantId, isDefault])
}

// ============================================
// ANALYTICS STUDIO — Advanced Models
// ============================================

model AnalyticsDataset {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  name          String
  description   String?
  slug          String

  // Source
  sourceType    String   @default("QUERY") // QUERY, MATERIALIZED_VIEW, CUSTOM_TABLE
  sourceQuery   String?  @db.Text // SQL query yang menjadi sumber
  sourceView    String?  // Materialized view name
  schemaDef     String?  @db.Text // JSON: column definitions

  // Permissions
  visibility    String   @default("PRIVATE") // PRIVATE, TEAM, DEPARTMENT, ORGANIZATION
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  ownerName     String?

  // Metadata
  columnCount   Int      @default(0)
  rowCount      Int?
  lastRefreshed DateTime?
  refreshFreq   String?  // REALTIME, HOURLY, DAILY

  charts        AnalyticsChart[]

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerId])
}

model AnalyticsQueryHistory {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  userName      String?

  // Query
  queryType     String   // SQL, VISUAL, AI, DASHBOARD, KPI
  sql           String   @db.Text
  visualConfig  String?  @db.Text // JSON: VisualQueryConfig
  datasetId     String?
  datasetName   String?

  // Results
  executionMs   Int
  rowsReturned  Int
  rowsScanned   Int?
  status        String   // SUCCESS, FAILED, TIMEOUT, BLOCKED
  errorMessage  String?
  fromCache     Boolean  @default(false)

  // Metadata
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([queryType])
  @@index([status])
}

model AnalyticsChart {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  name          String
  description   String?
  slug          String

  // Chart Config
  chartType     String   // bar, line, pie, donut, area, scatter, heatmap, kpi_card, table
  config        String   @default("{}") @db.Text // JSON: ChartConfig

  // Data Source
  dataSource    String   @default("DATASET") // DATASET, QUERY, METRIC
  datasetId     String?
  dataset       AnalyticsDataset? @relation(fields: [datasetId], references: [id])
  queryId       String?
  metricId      String?
  queryConfig   String?  @db.Text // JSON: VisualQueryConfig inline

  // Ownership
  visibility    String   @default("PRIVATE") // PRIVATE, TEAM, DEPARTMENT, ORGANIZATION
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  ownerName     String?

  // Metadata
  viewCount     Int      @default(0)
  lastViewedAt  DateTime?
  isTemplate    Boolean  @default(false)
  tags          String?  // JSON array

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerId])
  @@index([datasetId])
}

model AnalyticsDashboard {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  name          String
  description   String?
  slug          String

  // Layout
  layout        String   @default("{}") @db.Text // JSON: DashboardLayout
  theme         String?  // LIGHT, DARK, AUTO

  // Visibility & Access
  visibility    String   @default("PRIVATE") // PRIVATE, TEAM, DEPARTMENT, ORGANIZATION
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  ownerName     String?
  department    String?
  allowedRoles  String?  // JSON array
  allowedUsers  String?  // JSON array

  // Metadata
  isDefault     Boolean  @default(false)
  isTemplate    Boolean  @default(false)
  tags          String?  // JSON array
  viewCount     Int      @default(0)
  lastViewedAt  DateTime?
  refreshAll    Int?     // Global refresh interval (seconds)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  widgets       AnalyticsDashboardWidget[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerId])
}

model AnalyticsDashboardWidget {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  dashboardId   String
  dashboard     AnalyticsDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  // Widget Config
  title         String
  type          String   // CHART, KPI_CARD, TABLE, TEXT, IMAGE, METRIC_COMPARISON
  chartType     String?  // BAR, PIE, LINE, etc.
  size          String   @default("MEDIUM") // SMALL, MEDIUM, LARGE, FULL_WIDTH

  // Grid Position
  gridX         Int      @default(0)
  gridY         Int      @default(0)
  gridW         Int      @default(6)  // Column span (1-12)
  gridH         Int      @default(4)  // Row span

  // Data Source
  dataSource    String   @default("METRIC") // METRIC, CHART, QUERY, SQL, STATIC
  metricId      String?
  chartId       String?
  queryId       String?
  sql           String?  @db.Text
  staticData    String?  @db.Text // JSON: for static widgets

  // Display Config
  config        String   @default("{}") @db.Text // JSON: colors, labels, formatting
  refreshInterval Int?   // seconds, null = no auto-refresh

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([dashboardId])
}

model DataDictionaryEntry {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  // Identity
  name          String
  type          String   // metric, dimension, measure, dataset, field
  category      String   // finance, sales, inventory, hr, crm

  // Definition
  businessDef   String   @db.Text
  technicalDef  String?  @db.Text
  example       String?  @db.Text

  // Source
  sourceModule  String
  sourceModel   String
  sourceField   String?

  // Formula
  formula       String?  @db.Text
  dependencies  String?  // JSON array of entry IDs

  // Lineage
  upstreamDeps  String?  // JSON array
  downstreamDeps String? // JSON array

  // Quality
  freshness     String?  // REALTIME, HOURLY, DAILY, WEEKLY
  reliability   String?  // HIGH, MEDIUM, LOW
  lastVerified  DateTime?

  // Ownership
  owner         String?
  department    String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([name])
}

model ScheduledQuery {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  name            String
  description     String?

  // Source
  queryHistoryId  String   // Reference to the query to re-run
  datasetId       String?

  // Schedule
  cronExpression  String
  frequency       String   // DAILY, WEEKLY, MONTHLY, QUARTERLY
  timeOfDay       String   @default("08:00")

  // Output
  outputFormat    String   @default("EMAIL") // EMAIL, PDF, EXCEL, CSV, SLACK
  recipients      String[] @default([])

  // Alert
  alertOnFailure  Boolean  @default(true)
  alertOnAnomaly  Boolean  @default(false)

  // Status
  isActive        Boolean  @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String?
  runCount        Int      @default(0)

  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@index([nextRunAt])
  @@index([ownerId])
}

model MetricDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  name        String
  displayName String
  description String?
  category    String   // finance, sales, crm, inventory, hr
  formula     String   @db.Text // SQL expression or reference to other metrics
  dataType    String   // number, percentage, currency, duration
  format      String?  // display format
  unit        String?  // USD, %, etc
  source      String?  // which table/view

  isSystem    Boolean  @default(false)
  isCustom    Boolean  @default(true)

  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([tenantId, category])
}

// ============================================
// SETTINGS: NOTIFICATIONS & INTEGRATIONS
// ============================================

model TenantNotificationSettings {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  // Email notifications
  emailInvoice        Boolean @default(true)
  emailPayment        Boolean @default(true)
  emailOverdue        Boolean @default(true)
  emailWeeklyReport   Boolean @default(true)
  emailMarketing      Boolean @default(false)

  // Push (in-app) notifications
  pushInvoice         Boolean @default(true)
  pushPayment         Boolean @default(true)
  pushOverdue         Boolean @default(true)
  pushMention         Boolean @default(true)

  // WhatsApp notifications
  whatsappInvoice     Boolean @default(true)
  whatsappPayment     Boolean @default(true)
  whatsappOverdue     Boolean @default(false)

  // SMS notifications
  smsOverdue          Boolean @default(false)
  smsPayment          Boolean @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId])
  @@index([tenantId])
}

model TenantIntegration {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  type          String   // 'whatsapp', 'email', 'payment', 'accounting', 'marketplace', 'logistics'
  name          String
  status        String   @default("inactive") // 'active', 'inactive', 'error'

  // Configuration (JSON)
  config        Json     @default("{}")

  // Credentials (stored as-is — encrypted at rest via DB encryption or app-level)
  apiKey        String?
  apiSecret     String?
  webhookUrl    String?

  lastSyncAt    DateTime?
  lastErrorAt   DateTime?
  lastError     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, type, name])
  @@index([tenantId])
  @@index([tenantId, type])
}

// ============================================
// WORKFLOW ENGINE
// ============================================

model WorkflowDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  entityType  String   // 'INVOICE', 'QUOTATION', 'PURCHASE_ORDER', 'LEAVE_REQUEST', 'PAYROLL', 'DEAL'
  name        String
  description String?
  config      Json     // WorkflowDefinition JSON: { states, transitions, initialState, finalStates }
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false) // System workflows cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, entityType])
  @@index([tenantId])
}

model WorkflowHistory {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  entityType      String
  entityId        String
  fromState       String
  toState         String
  action          String
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
}

// ============================================
// INDUSTRY CONFIGURATION ENGINE
// ============================================

model IndustryConfiguration {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industry      String   // IndustryType: retail, manufacturing, services, etc.
  config        Json     // IndustryConfig overrides (partial)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId])
  @@index([tenantId])
}

model TenantCustomField {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity        String   // e.g., 'product', 'invoice', 'contact'
  fieldName     String
  fieldLabel    String
  fieldType     String   // 'text', 'number', 'date', 'select', 'boolean'
  required      Boolean  @default(false)
  options       Json?    // for select type: ["Option 1", "Option 2"]
  defaultValue  Json?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, entity, fieldName])
  @@index([tenantId, entity])
  @@index([tenantId])
}

// ============================================
// GENERAL LEDGER & JOURNAL ENTRY
// ============================================

model JournalEntry {
  id            String   @id @default(cuid())
  tenantId      String
  entryNumber   String   @unique
  date          DateTime @default(now())
  description   String
  reference     String?
  sourceType    String   // 'manual', 'invoice', 'payment', 'purchase_order', 'payroll'
  sourceId      String?
  status        String   @default("DRAFT") // DRAFT, POSTED, VOID
  totalDebit    Decimal  @default(0) @db.Decimal(19, 4)
  totalCredit   Decimal  @default(0) @db.Decimal(19, 4)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         JournalEntryItem[]
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
  @@index([entryNumber])
}

model JournalEntryItem {
  id             String   @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(19, 4)
  credit         Decimal  @default(0) @db.Decimal(19, 4)
  description    String?
  createdAt      DateTime @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        CoAAccount   @relation(fields: [accountId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
}

// ============================================
// ENTITLEMENT ENGINE — Plan-based Feature Gating
// ============================================

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  priceMonthly  Decimal  @default(0) @db.Decimal(19, 4) // in Rupiah
  priceYearly   Decimal? @db.Decimal(19, 4) // in Rupiah, with discount
  maxUsers      Int      // -1 = unlimited
  maxStorage    Int?     // in MB, null = unlimited
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  features      PlanFeature[]
  entitlements  TenantEntitlement[]
}

model PlanFeature {
  id            String   @id @default(cuid())
  planId        String
  featureKey    String   // e.g., "finance.invoice", "hr.employees", "ai.chat"
  enabled       Boolean  @default(true)
  limit         Int?     // null = unlimited, number = monthly limit
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}

model TenantEntitlement {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  planId        String
  billingCycle  String    @default("monthly") // monthly, yearly
  status        String    @default("active")  // active, trial, suspended, cancelled
  trialEndsAt   DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan      @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model UsageRecord {
  id            String   @id @default(cuid())
  tenantId      String
  featureKey    String
  count         Int      @default(1)
  period        String   // YYYY-MM
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey, period])
  @@index([tenantId])
  @@index([featureKey])
  @@index([period])
}

// ============================================
// RATE LIMITING
// ============================================

model RateLimitLog {
  id            String   @id @default(cuid())
  tenantId      String?
  ip            String
  endpoint      String
  requestCount  Int
  windowStart   DateTime
  windowEnd     DateTime
  blocked       Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([ip])
  @@index([endpoint])
  @@index([windowStart])
  @@index([createdAt])
}

// ============================================
// PERIOD CLOSING — Accounting Period Management
// ============================================

model AccountingPeriod {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String   // "Januari 2026", "Q1 2026"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("OPEN") // OPEN, CLOSING, CLOSED
  closedBy      String?  // userId yang menutup
  closedAt      DateTime?
  closeNotes    String?  // Catatan saat closing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, startDate])
}

// ============================================
// APPROVAL ENGINE — Multi-level Approval Workflow
// ============================================

model ApprovalLevel {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  entityType    String   // "INVOICE", "PURCHASE_ORDER", "QUOTATION"
  level         Int      // 1, 2, 3 (urutan approval)
  name          String   // "Manager Approval", "Director Approval"
  requiredRole  String   // "ADMIN", "MEMBER" — minimum role yang bisa approve
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, entityType, level])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  entityType    String   // "INVOICE", "PURCHASE_ORDER", "QUOTATION"
  entityId      String   // ID dari invoice/PO/quotation
  currentLevel  Int      // Level approval saat ini (1, 2, 3)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  requestedBy   String   // userId yang request
  requestedAt   DateTime @default(now())
  resolvedBy    String?  // userId yang approve/reject
  resolvedAt    DateTime?
  comments      String?  // Komentar saat approve/reject
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

// ============================================
// CRM ACTIVITIES
// ============================================

model Activity {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  entityType  String    // CONTACT, LEAD, DEAL
  entityId    String
  type        String    // CALL, EMAIL, MEETING, NOTE, TASK
  subject     String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId])
}

// ============================================
// IN-APP NOTIFICATIONS
// ============================================

model InAppNotification {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  type        String   // 'approval', 'payment', 'team', 'system', 'audit'
  title       String
  message     String
  link        String?  // Optional URL to navigate to
  isRead      Boolean  @default(false)
  metadata    Json?    // Additional context data
  createdAt   DateTime @default(now())

  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
}

// ============================================
// POS (POINT OF SALE)
// ============================================

model PosTerminal {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  code          String   // Unique per tenant
  location      String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      PosSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PosSession {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  terminalId      String
  terminal        PosTerminal @relation(fields: [terminalId], references: [id])
  cashierId       String
  cashierName     String
  status          String    @default("OPEN") // OPEN, CLOSED
  openingCash     Decimal   @default(0)
  closingCash     Decimal?
  expectedCash    Decimal?
  variance        Decimal?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions    PosTransaction[]

  @@index([tenantId])
  @@index([tenantId, terminalId])
  @@index([tenantId, status])
}

model PosTransaction {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  sessionId       String
  session         PosSession @relation(fields: [sessionId], references: [id])
  terminalId      String
  transactionNo   String    // Auto-generated, unique per tenant
  customerName    String?
  customerPhone   String?
  subtotal        Decimal   @default(0)
  discountAmount  Decimal   @default(0)
  discountPercent Decimal?
  taxAmount       Decimal   @default(0)
  totalAmount     Decimal   @default(0)
  paidAmount      Decimal   @default(0)
  changeAmount    Decimal   @default(0)
  paymentMethod   String    @default("CASH") // CASH, CARD, QRIS, E_WALLET, BANK_TRANSFER
  status          String    @default("COMPLETED") // COMPLETED, VOIDED, REFUNDED
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           PosTransactionItem[]
  payments        PosPayment[]
  refunds         PosRefund[]

  @@unique([tenantId, transactionNo])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model PosTransactionItem {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  transactionId   String
  transaction     PosTransaction @relation(fields: [transactionId], references: [id])
  productId       String
  productName     String
  productSku      String?
  quantity        Decimal   @default(1)
  unitPrice       Decimal
  discountAmount  Decimal   @default(0)
  discountPercent Decimal?
  taxRate         Decimal   @default(0)
  taxAmount       Decimal   @default(0)
  subtotal        Decimal   @default(0)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, transactionId])
  @@index([tenantId, productId])
}

model PosPayment {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  transactionId   String
  transaction     PosTransaction @relation(fields: [transactionId], references: [id])
  method          String    // CASH, CARD, QRIS, E_WALLET, BANK_TRANSFER
  amount          Decimal
  reference       String?   // Card number last 4, QRIS ref, etc.
  status          String    @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, transactionId])
  @@index([tenantId, status])
}

model PosRefund {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  transactionId   String
  transaction     PosTransaction @relation(fields: [transactionId], references: [id])
  refundNo        String    // Auto-generated, unique per tenant
  amount          Decimal
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, refundNo])
  @@index([tenantId])
  @@index([tenantId, transactionId])
  @@index([tenantId, status])
}
