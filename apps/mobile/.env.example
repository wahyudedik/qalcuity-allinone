# ==========================================
# Qalcuity Mobile — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# Expo reads EXPO_PUBLIC_* variables automatically at build time.

# ==========================================
# API CONFIGURATION (Required)
# ==========================================
# Base URL for the Qalcuity backend API (no trailing slash)
# Development:  http://localhost:3000/api
# Staging:      https://staging.qalcuity.com/api
# Production:   https://qalcuity.com/api
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# ==========================================
# APP CONFIGURATION (Optional)
# ==========================================
# App display name (default: Qalcuity)
# EXPO_PUBLIC_APP_NAME="Qalcuity"

# ==========================================
# NOTES
# ==========================================
# - After changing .env, restart Expo with: npx expo start --clear
# - EXPO_PUBLIC_* variables are embedded in the app bundle at build time
# - For EAS Build, set env vars in eas.json or via EAS dashboard
# - The API URL can also be configured in app.json > expo > extra > apiUrl
