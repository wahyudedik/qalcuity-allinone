# ==========================================
# QALCUITY PRODUCTION ENVIRONMENT — EXAMPLE
# ==========================================
# ⚠️ Copy this file to .env.production and fill in the values.
# ⚠️ NEVER commit .env.production to the repository!
# ⚠️ Generate secrets with: openssl rand -hex 32
# ==========================================

# ==========================================
# CORE (Required)
# ==========================================
NEXTAUTH_URL="https://qalcuity.com"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Mobile Auth JWT Secret (REQUIRED for mobile app — separate from NEXTAUTH_SECRET)
JWT_SECRET="your-jwt-secret-here"

# ==========================================
# DATABASE (Required)
# ==========================================
# Use a managed PostgreSQL instance (e.g., Supabase, Neon, AWS RDS)
DATABASE_URL="postgresql://username:password@localhost:5432/qalcuity?schema=public"

# ==========================================
# APP
# ==========================================
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Qalcuity ERP"
NEXT_PUBLIC_APP_URL="https://qalcuity.com"

# ==========================================
# REDIS (Optional — Rate Limiting & Caching)
# ==========================================
# If not configured, falls back to in-memory rate limiter
# Redis is REQUIRED for production multi-instance deployments
REDIS_URL="redis://:your-redis-password@localhost:6379"

# ==========================================
# PRISMA ENGINE (Required for VPS that can't download binary)
# ==========================================
# VPS ini tidak bisa download Prisma engine binary dari binaries.prisma.sh
# Gunakan library engine sebagai workaround
PRISMA_QUERY_ENGINE_TYPE=library

# ==========================================
# SMTP — Email Delivery (Required for production)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Your App <noreply@qalcuity.com>"
SMTP_SECURE=false

# SMTP Encryption Key (for AES-256-GCM encrypted SMTP password)
# Generate: openssl rand -hex 32 (must be exactly 64 hex characters)
# If set, SMTP_PASS value will be treated as encrypted and decrypted at runtime
# If not set, SMTP_PASS is used as plaintext (backward compatible)
SMTP_ENCRYPTION_KEY="your-smtp-encryption-key-here"

# ==========================================
# PAYMENT GATEWAY (Optional — configure at least one for billing)
# ==========================================
PAYMENT_PROVIDER="mock"  # 'midtrans', 'xendit', or 'mock'

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_IS_PRODUCTION=true

# Xendit (alternative payment gateway)
# Set PAYMENT_PROVIDER="xendit" to activate
XENDIT_SECRET_KEY=""
XENDIT_API_KEY=""
XENDIT_API_VERSION="2023-07-01"
XENDIT_IS_PRODUCTION=true
XENDIT_CALLBACK_TOKEN=""  # Generate: openssl rand -hex 32 — used to verify webhook callbacks

# ==========================================
# WHATSAPP BUSINESS API (Optional)
# ==========================================
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY=""

# ==========================================
# AI (Optional)
# ==========================================
AI_PROVIDER="mock"  # 'openai' or 'mock'
AI_API_KEY=""       # OpenAI API key (user can configure via dashboard)
AI_MODEL="gpt-4o-mini"

# ==========================================
# PLATFORM OWNER (Security — controls /platform access)
# ==========================================
# Only this email can access /platform admin panel
# SUPERADMIN role is exclusively for this user
PLATFORM_OWNER_EMAIL="info@qalcuity.com"

# ==========================================
# GOOGLE OAUTH (Optional — enables Google login)
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
# Set to "true" to skip Google OAuth network health check (VPS cannot reach accounts.google.com)
GOOGLE_OAUTH_SKIP_HEALTH_CHECK="true"

# ==========================================
# APP TIMEZONE
# ==========================================
# Timezone untuk cron schedule calculations, date formatting
# Default: Asia/Jakarta (WIB, UTC+7)
# Format: IANA timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
APP_TIMEZONE="Asia/Jakarta"

# ==========================================
# CRON (Required for cron endpoints)
# ==========================================
# Used by external cron service (cron-job.org, aaPanel Task Scheduler)
CRON_SECRET="your-cron-secret-here"
