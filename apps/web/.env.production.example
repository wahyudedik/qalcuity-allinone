# ==========================================
# Qalcuity Production Environment Variables
# ==========================================
# Copy this file to .env.production and fill in actual values.
# ⚠️ JANGAN commit .env.production ke repository!
# Generate NEXTAUTH_SECRET: openssl rand -hex 32
# Generate CRON_SECRET: openssl rand -hex 32

# ==========================================
# CORE (Required)
# ==========================================
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-a-strong-random-secret"

# ==========================================
# DATABASE (Required)
# ==========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@host:5432/dbname?schema=public"

# ==========================================
# APP
# ==========================================
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Qalcuity ERP"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ==========================================
# REDIS (Optional — Rate Limiting & Caching)
# ==========================================
# Redis is REQUIRED for production multi-instance deployments
# If not configured, falls back to in-memory rate limiter
REDIS_URL="redis://default:your-password@host:6379"

# ==========================================
# PRISMA ENGINE (Required for VPS that can't download binary)
# ==========================================
# Uncomment if VPS cannot download Prisma engine binary
# PRISMA_QUERY_ENGINE_TYPE=library

# ==========================================
# SMTP — Email Delivery (Required for production)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="info@yourdomain.com"
SMTP_SECURE=false

# ==========================================
# PAYMENT GATEWAY (Optional)
# ==========================================
PAYMENT_PROVIDER="mock"  # 'midtrans', 'xendit', or 'mock'

# Midtrans
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# MIDTRANS_MERCHANT_ID="G123456789"
# MIDTRANS_IS_PRODUCTION=true

# Xendit (alternative)
# XENDIT_SECRET_KEY="xnd_live_xxxx"
# XENDIT_API_VERSION="2023-07-01"
# XENDIT_IS_PRODUCTION=true
# XENDIT_WEBHOOK_SECRET_KEY="your-webhook-secret"

# ==========================================
# WHATSAPP BUSINESS API (Optional)
# ==========================================
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY="your-whatsapp-api-key"

# ==========================================
# AI (Optional)
# ==========================================
AI_PROVIDER="mock"  # 'openai', 'openrouter', 'ollama', or 'mock'
# AI_API_KEY="sk-xxxx"
# AI_MODEL="gpt-4o-mini"

# ==========================================
# PLATFORM OWNER (Security — controls /platform access)
# ==========================================
# Only this email can access /platform admin panel
# SUPERADMIN role is exclusively for this user
PLATFORM_OWNER_EMAIL="admin@yourdomain.com"

# ==========================================
# GOOGLE OAUTH (Optional — enables Google login)
# ==========================================
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
# Set to "true" if VPS cannot reach accounts.google.com (firewall/DNS restriction)
# GOOGLE_OAUTH_SKIP_HEALTH_CHECK="true"

# ==========================================
# APP TIMEZONE
# ==========================================
# Timezone for cron schedule calculations, date formatting
# Default: Asia/Jakarta (WIB, UTC+7)
# Format: IANA timezone
APP_TIMEZONE="Asia/Jakarta"

# ==========================================
# CRON — Scheduled Tasks (Required for production)
# ==========================================
# Secret token for authenticating cron job requests
# Generate: openssl rand -hex 32
CRON_SECRET="generate-a-strong-random-secret-for-cron"
