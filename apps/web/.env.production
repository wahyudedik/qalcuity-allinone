# ===================================
# QALCUITY PRODUCTION ENVIRONMENT
# ===================================
# ⚠️ PENTING: Edit file ini di SERVER, bukan di local!
# ⚠️ JANGAN commit file ini ke repository!
# ⚠️ Generate NEXTAUTH_SECRET: openssl rand -hex 32
# ===================================

# ==========================================
# CORE (Required)
# ==========================================
NEXTAUTH_URL="https://qalcuity.com"
NEXTAUTH_SECRET="3522d3dba1ab5934eb53c5b52a3e9b6afb2af46427f6408bd1a233670a4c3e36"  # Generate with: openssl rand -hex 32

# ==========================================
# DATABASE (Required)
# ==========================================
# Use a managed PostgreSQL instance (e.g., Supabase, Neon, AWS RDS)
DATABASE_URL="postgresql://qalcuity:CBknLz8ahLZ8Jnty@localhost:5432/qalcuity?schema=public"

# ==========================================
# APP
# ==========================================
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Qalcuity"
NEXT_PUBLIC_APP_URL="https://qalcuity.com"

# ==========================================
# SMTP — Email Delivery (Required for production)
# ==========================================
SMTP_HOST="mail.noteds.com"
SMTP_PORT=587
SMTP_USER="info@noteds.com"
SMTP_PASS="Wahyu123456789@"
SMTP_FROM="info@qalcuity.com"
SMTP_SECURE=true

# ==========================================
# PAYMENT GATEWAY (Optional — configure at least one for billing)
# ==========================================
PAYMENT_PROVIDER="midtrans"  # 'midtrans', 'xendit', or 'mock'

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_IS_PRODUCTION=true

# Xendit (alternative)
# XENDIT_SECRET_KEY=""
# XENDIT_API_VERSION="2023-07-01"
# XENDIT_IS_PRODUCTION=true
# XENDIT_WEBHOOK_SECRET_KEY=""

# ==========================================
# WHATSAPP BUSINESS API (Optional)
# ==========================================
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY=""

# ==========================================
# AI (Optional)
# ==========================================
AI_PROVIDER="mock"  # 'openai' or 'mock'
AI_API_KEY=""       # OpenAI API key (user can configure via dashboard)
AI_MODEL="gpt-4o-mini"
