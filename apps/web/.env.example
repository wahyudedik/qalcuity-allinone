# ==========================================
# Qalcuity All-in-One — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# See docs/ARCHITECTURE.md for full documentation.

# ==========================================
# CORE (Required)
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ==========================================
# DATABASE (Required)
# ==========================================
# PostgreSQL connection string (DBngin local uses trust auth — no password needed)
# Format: postgresql://username:password@localhost:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/qalcuity?schema=public"

# ==========================================
# APP
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Qalcuity"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prisma engine type (set to 'library' for VPS/hosting that can't download binary)
# PRISMA_QUERY_ENGINE_TYPE="library"

# ==========================================
# REDIS (Optional — Rate Limiting & Caching)
# ==========================================
# If not configured, falls back to in-memory rate limiter
# Redis is REQUIRED for production multi-instance deployments
# REDIS_URL="redis://localhost:6379"                        # Without password
# REDIS_URL="redis://:password@localhost:6379"              # With password
# REDIS_TOKEN=""                    # Optional: auth token for cloud Redis (Upstash, Redis Cloud)
# REDIS_KEY_PREFIX="qalcuity:"      # Optional: prefix for all Redis keys

# ==========================================
# RATE LIMITING (Optional — defaults provided)
# ==========================================
# All rate limiting config via environment variables
# Auth: 5 requests per 15 minutes (brute force protection)
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_BLOCK_THRESHOLD=3
# RATE_LIMIT_AUTH_BLOCK_DURATION_MS=3600000
# API: 100 requests per 15 minutes
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_API_WINDOW_MS=900000
# Upload: 10 requests per hour
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
# Search: 50 requests per minute
# RATE_LIMIT_SEARCH_MAX=50
# RATE_LIMIT_SEARCH_WINDOW_MS=60000
# Admin: 200 requests per 15 minutes
# RATE_LIMIT_ADMIN_MAX=200
# RATE_LIMIT_ADMIN_WINDOW_MS=900000
# Public: 20 requests per 15 minutes
# RATE_LIMIT_PUBLIC_MAX=20
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000

# ==========================================
# SMTP — Email Delivery (Required for production)
# ==========================================
# Configure SMTP to enable real email delivery (invoices, notifications, etc.).
# If not configured, emails are logged to console (development mode).
SMTP_HOST="your-mail-host.com"
SMTP_PORT=465
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-mail-password"
SMTP_FROM="info@yourdomain.com"
SMTP_SECURE=true

# ==========================================
# PAYMENT GATEWAY — User-Managed (Optional)
# ==========================================
# Payment provider: 'midtrans', 'xendit', or 'mock' (default: mock)
# PAYMENT_PROVIDER="mock"

# Midtrans
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# MIDTRANS_MERCHANT_ID="G123456789"
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_WEBHOOK_SECRET="your-webhook-secret"

# Xendit
# XENDIT_SECRET_KEY="xnd_development_xxxx"
# XENDIT_API_VERSION="2023-07-01"
# XENDIT_IS_PRODUCTION=false
# XENDIT_WEBHOOK_SECRET_KEY="your-webhook-secret"

# ==========================================
# WHATSAPP BUSINESS API — User-Managed (Optional)
# ==========================================
# User provides their own WhatsApp Business API credentials
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY="your-whatsapp-api-key"

# ==========================================
# AI — Built-in (Optional)
# ==========================================
# AI provider: 'openai' or 'mock' (default: mock)
# User configures their own API key via the dashboard
AI_PROVIDER="mock"
# AI_API_KEY="sk-xxxx"
# AI_MODEL="gpt-4o-mini"

# ==========================================
# PLATFORM OWNER (Security — controls /platform access)
# ==========================================
# Only this email can access /platform admin panel
# SUPERADMIN role is exclusively for this user
PLATFORM_OWNER_EMAIL="info@qalcuity.com"

# ==========================================
# GOOGLE OAUTH (Optional — enables Google login)
# ==========================================
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
