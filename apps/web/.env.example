# ==========================================
# Qalcuity All-in-One - Environment Variables
# ==========================================

# Copy this file to .env and fill in the values

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL (default — used for both development and production)
# Format: postgresql://username:password@localhost:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/qalcuity?schema=public"

# ==========================================
# AUTH (NextAuth.js)
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ==========================================
# APP
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Qalcuity"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# INTEGRATIONS (User-Managed)
# ==========================================
# WhatsApp Business API (user provides their own key)
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY="your-whatsapp-api-key"

# ==========================================
# PAYMENT GATEWAY (User provides their own keys)
# ==========================================
# Midtrans
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# MIDTRANS_IS_PRODUCTION=false

# Xendit
# XENDIT_SECRET_KEY="xnd_development_xxxx"
# XENDIT_API_VERSION="2023-07-01"
# XENDIT_IS_PRODUCTION=false
# XENDIT_WEBHOOK_SECRET_KEY="your-webhook-secret"

# ==========================================
# SMTP (Email Delivery)
# ==========================================
# SMTP server configuration for sending emails (invoices, notifications, etc.)
# If not configured, emails will be logged to console (development mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qalcuity.com
SMTP_SECURE=false

# ==========================================
# AI (Built-in — User configures via dashboard)
# ==========================================
# AI_PROVIDER="openai"       # 'openai' or 'mock' (default: mock)
# AI_API_KEY="sk-xxxx"       # OpenAI API key
# AI_MODEL="gpt-4o-mini"     # Default model (default: gpt-4o-mini)
