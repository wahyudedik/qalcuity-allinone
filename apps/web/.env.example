# ==========================================
# Qalcuity All-in-One — Environment Variables
# ==========================================
# Copy this file to .env and fill in the values.
# See docs/ARCHITECTURE.md for full documentation.

# ==========================================
# CORE (Required)
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# ==========================================
# DATABASE (Required)
# ==========================================
# PostgreSQL connection string (DBngin local uses trust auth — no password needed)
# Format: postgresql://username:password@localhost:5432/dbname?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/qalcuity?schema=public"

# ==========================================
# APP
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Qalcuity"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# REDIS (Optional — Rate Limiting & Caching)
# ==========================================
# If not configured, falls back to in-memory rate limiter
# REDIS_URL="redis://localhost:6379"

# ==========================================
# SMTP — Email Delivery (Optional)
# ==========================================
# Configure SMTP to enable real email delivery (invoices, notifications, etc.).
# If not configured, emails are logged to console (development mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@qalcuity.com"
SMTP_SECURE=false

# ==========================================
# PAYMENT GATEWAY — User-Managed (Optional)
# ==========================================
# Payment provider: 'midtrans', 'xendit', or 'mock' (default: mock)
# PAYMENT_PROVIDER="mock"

# Midtrans
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
# MIDTRANS_MERCHANT_ID="G123456789"
# MIDTRANS_IS_PRODUCTION=false

# Xendit
# XENDIT_SECRET_KEY="xnd_development_xxxx"
# XENDIT_API_VERSION="2023-07-01"
# XENDIT_IS_PRODUCTION=false
# XENDIT_WEBHOOK_SECRET_KEY="your-webhook-secret"

# ==========================================
# WHATSAPP BUSINESS API — User-Managed (Optional)
# ==========================================
# User provides their own WhatsApp Business API credentials
# WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages"
# WHATSAPP_API_KEY="your-whatsapp-api-key"

# ==========================================
# AI — Built-in (Optional)
# ==========================================
# AI provider: 'openai' or 'mock' (default: mock)
# User configures their own API key via the dashboard
AI_PROVIDER="mock"
# AI_API_KEY="sk-xxxx"
# AI_MODEL="gpt-4o-mini"

# ==========================================
# GOOGLE OAUTH (Optional — enables Google login)
# ==========================================
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
